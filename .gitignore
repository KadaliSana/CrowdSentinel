.env
*.zip
# AWS credentials live here - never commit
src/firmware_webrtc/examples/demo_config/demo_config.h

# regenerable firmware build output
*/GCC-RELEASE/build/
*/GCC-RELEASE/build_*/

# nested git repos (own history/remote, not captured by this repo)
models/acuity/

# backup config files can carry the same live credentials as demo_config.h.
# *.bak alone does NOT match a timestamped backup such as .env.bak.1787920463,
# which is exactly how a live AWS key ended up sitting untracked-but-committable.
*.bak
*.bak.*
.env
.env.*

# local convenience symlink to a reference tree outside this repo
/webrtc

# compiled firmware images can have credentials baked in from demo_config.h
flash/Pro2_PG_tool_v1.4.3/flash_ntz.bin
flash/Pro2_PG_tool_v1.4.3/known_good_1626.nn.bin
flash/reference/

# python build artifacts (regenerable)
venv/
.venv/
__pycache__/
*.pyc
.DS_Store

# training dataset images (large, not pushed)
models/dataset/train/
models/dataset/valid/
models/dataset/test/

# pretrained base checkpoints (not the model in use) and regenerable ONNX exports
models/dataset/yolo26n.pt
models/dataset/yolo26s.pt
models/weights/*.onnx
flash/Pro2_PG_tool_v1.4.3/flash_ntz.nn.bin

# downloaded papers: copyrighted publisher PDFs, do not redistribute
docs/litreview/pdfs/

# editable-install metadata (pyproject / pip install -e .)
*.egg-info/
